# DealPilot AI — environment variables (copy to your host's secret manager; never commit real values).
# The existing Christ: The Scroll app uses its own variables; see replit.md.

# --- Required -----------------------------------------------------------------
# PostgreSQL connection string. Add ?sslmode=require for managed databases.
DATABASE_URL=postgres://dealpilot:change-me@localhost:5432/dealpilot_dev
# Random string, 32+ characters (e.g. `openssl rand -hex 32`). Required when NODE_ENV=production.
# Changing it signs everyone out.
BETTER_AUTH_SECRET=
# Public origin of the deployed app (used for auth cookies and CSRF origin checks).
DEALPILOT_APP_URL=http://localhost:8090

# --- Runtime ------------------------------------------------------------------
NODE_ENV=development
PORT=8090
# Extra allowed browser origins, comma-separated (the Vite dev server on :5173/:5174 is allowed automatically outside production).
DEALPILOT_TRUSTED_ORIGINS=
# Allow "Try a demo workspace" (anonymous, isolated accounts). true/false.
DEALPILOT_ALLOW_DEMO_ACCOUNTS=true
# Apply database migrations at startup. Set false if you run `pnpm run dealpilot:migrate` in a release step.
DEALPILOT_AUTO_MIGRATE=true
LOG_LEVEL=info

# --- AI analyst (optional) -----------------------------------------------------
# Without a key the analyst runs in clearly labelled demo mode.
ANTHROPIC_API_KEY=
DEALPILOT_LLM_MODEL=claude-opus-5-5
# Max AI requests (reviews, questions, workflow runs) per user per 10 minutes.
DEALPILOT_AI_RATE_LIMIT=30

# --- Reserved for future adapters (setting these does NOT enable anything yet) ---
RENTCAST_API_KEY=
MAPBOX_TOKEN=
RESEND_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Tests ----------------------------------------------------------------------
# Separate, disposable database: the API integration tests DROP and recreate its public schema.
DEALPILOT_TEST_DATABASE_URL=postgres://dealpilot:change-me@localhost:5432/dealpilot_test
# Optional: Chromium path for Playwright if its bundled browser is unavailable.
PLAYWRIGHT_CHROMIUM_PATH=
